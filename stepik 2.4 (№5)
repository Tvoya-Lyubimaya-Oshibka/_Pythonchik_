#Дано трехзначное число abc,в котором все цифры различны.
#Напишите программу, которая выводит шесть чисел, образованных при перестановке цифр заданного числа

ch=int(input())
ch1=ch%10
ch2=(ch//10)%10
ch3=ch//100
print(ch)
print(ch3, ch1, ch2, sep='')
print(ch2, ch3, ch1, sep='')
print(ch2, ch1, ch3, sep='')
print(ch1, ch3, ch2, sep='')
print(ch1, ch2, ch3, sep='')
