#На вход программе подаются четыре целых числа h1, m1, h2, m2, которые задают временной промежуток от h₁:m₁ до h₂:m₂.
#Напишите программу, которая выводит все моменты времени между этими промежутками (включая границы)
#в формате hh:mm с интервалом в 1 минуту, каждый на отдельной строке.

h1 = int(input())
m1 = int(input())
h2 = int(input())
m2 = int(input())
s = h1*60 + m1
k = h2*60 + m2
vh = 0
for i in range(s, k+1):
    vh = i // 60
    vm = i % 60
    if vh < 10 :
        vh = '0' + str(vh)
    if vm < 10:
        vm = '0' + str(vm)
    print(vh,':', vm, sep='')
