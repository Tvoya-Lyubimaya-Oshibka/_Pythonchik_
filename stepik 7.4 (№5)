#На вход программе подаётся натуральное число n. 
#Напишите программу вычисления знакочередующейся суммы:1−2+3−4+5−6+…+(−1)**(n+1) * n

n = int(input())
chet = 0
nechet = 0
summi = 0
for i in range(1, n+1):
    if i % 2 == 0:
        chet += i
    if i % 2 == 1:
        nechet += i
summi = -chet + nechet + ((-1)**(n+1)) * n
print(summi)
