#Дан порядковый номер месяца (1,2,…,12). Напишите программу, которая выводит на экран количество дней в этом месяце. 
#Принять, что год является невисокосным.

a = int(input())
if a <= 7:
    if a % 2 == 1:
        print('31')
    if a % 2 == 0:
        if a == 2:
            print('28')
        else:
            print('30')
else:
    if a % 2 == 0:
        print('31')
    else:
        print('30')
